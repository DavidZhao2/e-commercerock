<main class="page-main product-page">
  <div class="product-layout">
    <!-- left side: image -->
    <section class="product-media">
      <div class="product-image-frame">
        <img
          src="/images/{{product.slug}}.jpg"
          alt="{{product.name}} crystal"
        />
      </div>
    </section>

    <!-- right side: main info -->
    <section class="product-main">
      <p class="product-tag">{{product.category}}</p>

      <h1 class="product-title">{{product.name}}</h1>

      <p class="product-description">
        {{product.description}}
      </p>

      <div class="product-price-row">
        <span class="product-price">${{product.price}}</span>
        <span class="product-badge">In stock</span>
      </div>

      <button type="button" class="btn-primary product-add-btn">
        Add to cart
      </button>
    </section>
  </div>

  <!-- details card -->
  <section class="product-details-card">
    <h2 class="section-title">Details</h2>

    <dl class="product-details-list">
      <div class="product-detail-row">
        <dt>Category</dt>
        <dd>{{product.category}}</dd>
      </div>

      <div class="product-detail-row">
        <dt>Size</dt>
        <dd>{{product.size}}</dd>
      </div>

      <div class="product-detail-row">
        <dt>Properties</dt>
        <dd>{{product.properties}}</dd>
      </div>
    </dl>
  </section>
</main>
