<section class="auth-layout">
  <section class="card auth-card">
    <h2>Login</h2>

    {{#if error}}
      <p class="form-error">{{error}}</p>
    {{/if}}

    {{#if success}}
      <p class="form-success">{{success}}</p>
    {{/if}}

    <form method="POST" action="/login">
      <label>
        Email
        <input
          type="email"
          name="email"
          placeholder="you@example.com"
          value="{{email}}"
          required
        />
      </label>

      <label>
        Password
        <input
          type="password"
          name="password"
          placeholder="********"
          required
        />
      </label>

      <button type="submit">Login</button>
    </form>
  </section>

  <section class="card auth-card">
    <h2>New here?</h2>
    <p>Create an account to browse, customize, and purchase our rocks.</p>
    <a href="/register">
      <button type="button">Register</button>
    </a>
  </section>
</section>
