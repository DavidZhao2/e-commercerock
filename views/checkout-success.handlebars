<main class="page-main checkout-page">
  <section class="card" style="max-width: 520px; margin: 0 auto; text-align: center;">
    <h1 style="margin-bottom: 0.75rem;">Thank you for your order ✨</h1>

    <p style="color: #9ca3af; margin-bottom: 1.25rem;">
      Your order has been placed successfully.
    </p>

    <div style="border-radius: 0.75rem; border: 1px solid #1f2937; padding: 1rem; margin-bottom: 1.25rem;">
      <p style="font-size: 0.9rem; color: #9ca3af; margin-bottom: 0.25rem;">
        Order Number
      </p>
      <p style="font-size: 1.2rem; font-weight: 600;">
        #{{orderNumber}}
      </p>

      <p style="font-size: 0.9rem; color: #9ca3af; margin-top: 0.75rem;">
        Order Total:
        <span style="color: #a5b4fc; font-weight: 600;">
          ${{subtotal}}
        </span>
      </p>
    </div>

    <a href="/" class="btn-primary" style="width: 100%; text-align: center;">
      Back to Home
    </a>
  </section>
</main>
