<main class="page-main">
  <section class="auth-layout">
    <article class="card">
      <h2>Create an account</h2>

      {{#if error}}
        <div class="form-error">
          {{error}}
        </div>
      {{/if}}

      <form method="POST" action="/register">
        <label>
          Name
          <input
            type="text"
            name="name"        
            placeholder="Your name"
            value="{{name}}"
            required
          />
        </label>

        <label>
          Email
          <input
            type="email"
            name="email"        
            placeholder="you@example.com"
            value="{{email}}"
            required
          />
        </label>

        <label>
          Password
          <input
            type="password"
            name="password"      
            placeholder="Enter a password"
            required
          />
        </label>

        <button type="submit">
          Create account
        </button>
      </form>
    </article>
  </section>
</main>
